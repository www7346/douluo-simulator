{
  "name": "douluo-independent-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite --config vite.config.mts --host 127.0.0.1",
    "build": "tsc -b && vite build --config vite.config.mts && node scripts/build-offline.cjs",
    "build:desktop": "node scripts/build-desktop.cjs",
    "build:cloud-service": "node scripts/build-cloud-service.cjs",
    "build:cloud-client": "vite build --config vite.config.mts --mode cloud",
    "typecheck": "tsc -b --pretty false",
    "prebuild:desktop": "node scripts/prepare-source-art.cjs",
    "prebuild:cloud-client": "node scripts/prepare-source-art.cjs",
    "test": "node --import tsx --test tests/*.test.cjs tests/*.test.ts"
  },
  "dependencies": {
    "highs": "1.15.4",
    "jsonrepair": "3.15.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.64.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.4"
  },
  "license": "GPL-3.0-only"
}
